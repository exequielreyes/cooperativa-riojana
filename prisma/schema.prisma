generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id               String               @id @default(cuid())
  email            String               @unique
  passwordHash     String
  rol              RolUsuario           @default(SOCIO)
  activo           Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  nombre           String?
  noticias         Noticia[]            @relation("AutorNoticia")
  pagosValidados   Pago[]               @relation("ValidadorPago")
  resetTokens      PasswordResetToken[]
  socio            Socio?
  talleresDictados Taller[]             @relation("ProfesorTaller")

  @@map("usuarios")
}

model Socio {
  id              String              @id @default(cuid())
  usuarioId       String              @unique
  nombre          String
  apellido        String
  dni             String              @unique
  fechaNacimiento DateTime?
  telefono        String?
  email           String
  direccion       String?
  region          String?
  idCooperativa   String              @unique
  tipoMiembro     TipoMiembro         @default(PRODUCTOR)
  estado          EstadoSocio         @default(PENDIENTE)
  fotoUrl         String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  moodleUserId    Int?
  motivoBaja      String?
  entrecalles     String              @default("") @db.VarChar(50)
  barrio          String              @default("") @db.VarChar(50)
  ocupacion       String              @default("") @db.VarChar(40)
  cuil            String              @default("") @db.VarChar(15)
  fechaing        DateTime            @default(now())
  fechaBaja       DateTime?
  cuotasCapital   Int                 @default(1)
  montoCapital    Decimal?            @db.Decimal(10, 2)
  cuotas          Cuota[]
  grupoFamiliar   GrupoFamiliar[]
  inscripciones   InscripcionTaller[]
  notificaciones  Notificacion[]
  pagos           Pago[]
  usuario         Usuario             @relation(fields: [usuarioId], references: [id])

  @@index([region])
  @@index([estado])
  @@map("socios")
}

model GrupoFamiliar {
  id              String    @id @default(cuid())
  socioId         String
  nombre          String
  apellido        String
  dni             String?
  parentesco      String
  fechaNacimiento DateTime?
  email           String?
  telefono        String?
  createdAt       DateTime  @default(now())
  socio           Socio     @relation(fields: [socioId], references: [id], onDelete: Cascade)

  @@index([socioId])
  @@map("grupo_familiar")
}

model ConfiguracionCooperativa {
  id                 String   @id @default("singleton")
  montoCuotaActual   Decimal  @default(12450.00) @db.Decimal(10, 2)
  cbu                String?
  alias              String?
  updatedAt          DateTime @updatedAt
  montoCapitalActual Decimal  @default(50000.00) @db.Decimal(10, 2)

  @@map("configuracion_cooperativa")
}

model ChatbotRespuesta {
  id            String   @id @default(cuid())
  pregunta      String?
  palabrasClave String   @db.Text
  respuesta     String   @db.Text
  link          String?
  linkTexto     String?
  orden         Int      @default(0)
  activa        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("chatbot_respuestas")
}

model Cuota {
  id               String      @id @default(cuid())
  socioId          String
  periodo          String
  concepto         String      @default("Cuota Social")
  monto            Decimal     @db.Decimal(10, 2)
  fechaVencimiento DateTime
  estado           EstadoCuota @default(PENDIENTE)
  createdAt        DateTime    @default(now())
  socio            Socio       @relation(fields: [socioId], references: [id])
  pagos            Pago[]

  @@index([socioId, estado])
  @@map("cuotas")
}

model Pago {
  id               String               @id @default(cuid())
  cuotaId          String
  socioId          String
  monto            Decimal              @db.Decimal(10, 2)
  metodo           MetodoPago
  comprobanteUrl   String?
  estadoValidacion EstadoValidacionPago @default(PENDIENTE_REVISION)
  fechaPago        DateTime             @default(now())
  validadoPorId    String?
  fechaValidacion  DateTime?
  notaRechazo      String?
  cuota            Cuota                @relation(fields: [cuotaId], references: [id])
  socio            Socio                @relation(fields: [socioId], references: [id])
  validadoPor      Usuario?             @relation("ValidadorPago", fields: [validadoPorId], references: [id])

  @@index([socioId])
  @@index([estadoValidacion])
  @@index([cuotaId])
  @@index([validadoPorId], map: "pagos_validadoPorId_fkey")
  @@map("pagos")
}

model Taller {
  id             String              @id @default(cuid())
  titulo         String
  slug           String              @unique
  descripcion    String              @db.Text
  categoria      String
  instructor     String?
  ubicacion      String?
  modalidad      ModalidadTaller     @default(PRESENCIAL)
  fecha          DateTime
  horaInicio     String
  horaFin        String?
  cuposTotales   Int
  imagenUrl      String?
  requisitos     String?             @db.Text
  queAprenderas  String?             @db.Text
  materialUrl    String?
  estado         String              @default("ACTIVO")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  moodleCourseId Int?
  descuento      Int?
  esPago         Boolean             @default(false)
  precio         Decimal?            @db.Decimal(10, 2)
  profesorId     String?
  contenidos     ContenidoTaller[]
  inscripciones  InscripcionTaller[]
  profesor       Usuario?            @relation("ProfesorTaller", fields: [profesorId], references: [id])

  @@index([fecha])
  @@index([profesorId])
  @@map("talleres")
}

model InscripcionTaller {
  id               String            @id @default(cuid())
  tallerId         String
  socioId          String
  estado           EstadoInscripcion @default(PENDIENTE)
  observaciones    String?
  fechaInscripcion DateTime          @default(now())
  comprobanteUrl   String?
  socio            Socio             @relation(fields: [socioId], references: [id])
  taller           Taller            @relation(fields: [tallerId], references: [id])

  @@unique([tallerId, socioId])
  @@index([socioId], map: "inscripciones_talleres_socioId_fkey")
  @@map("inscripciones_talleres")
}

model PreguntaFrecuente {
  id        String   @id @default(cuid())
  pregunta  String
  respuesta String   @db.Text
  orden     Int      @default(0)
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("preguntas_frecuentes")
}

model Noticia {
  id               String             @id @default(cuid())
  titulo           String
  slug             String             @unique
  contenido        String             @db.Text
  categoria        String
  imagenUrl        String?
  estado           EstadoContenido    @default(BORRADOR)
  autorId          String
  fechaPublicacion DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  redesSociales    NoticiaRedSocial[]
  autor            Usuario            @relation("AutorNoticia", fields: [autorId], references: [id])

  @@index([estado])
  @@index([autorId], map: "noticias_autorId_fkey")
  @@map("noticias")
}

model NoticiaRedSocial {
  id                String               @id @default(cuid())
  noticiaId         String
  redSocial         RedSocial
  estadoPublicacion EstadoPublicacionRed @default(PENDIENTE)
  urlPublicacion    String?
  fechaPublicacion  DateTime?
  noticia           Noticia              @relation(fields: [noticiaId], references: [id], onDelete: Cascade)

  @@unique([noticiaId, redSocial])
  @@map("noticia_redes_sociales")
}

model ContenidoTaller {
  id          String              @id @default(cuid())
  tallerId    String
  titulo      String
  descripcion String?             @db.Text
  tipo        TipoContenidoTaller @default(DOCUMENTO)
  url         String
  orden       Int                 @default(0)
  createdAt   DateTime            @default(now())
  taller      Taller              @relation(fields: [tallerId], references: [id], onDelete: Cascade)

  @@index([tallerId])
  @@map("contenidos_taller")
}

model ContenidoNosotros {
  id                    String   @id @default("singleton")
  heroBadge             String   @db.Text
  heroTitulo            String   @db.Text
  heroDescripcion       String   @db.Text
  heroBotonTexto        String   @db.Text
  heroImagenUrl         String?
  textoMision           String   @db.Text
  textoVision           String   @db.Text
  valores               Json
  origenesLabel         String   @db.Text
  origenesTitulo        String   @db.Text
  origenesParrafo1      String   @db.Text
  origenesParrafo2      String   @db.Text
  origenesParrafo3      String   @db.Text
  origenesImagenUrl     String?
  origenesBadgeNumero   String   @db.Text
  origenesBadgeTexto    String   @db.Text
  origenesHito1Titulo   String   @db.Text
  origenesHito1Texto    String   @db.Text
  origenesHito2Titulo   String   @db.Text
  origenesHito2Texto    String   @db.Text
  compromisoTitulo      String   @db.Text
  compromisoDescripcion String   @db.Text
  iniciativas           Json
  updatedAt             DateTime @updatedAt

  @@map("contenido_nosotros")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  usuarioId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("password_reset_tokens")
}

model Notificacion {
  id        String   @id @default(cuid())
  socioId   String
  titulo    String
  mensaje   String   @db.Text
  link      String?
  leida     Boolean  @default(false)
  createdAt DateTime @default(now())
  socio     Socio    @relation(fields: [socioId], references: [id], onDelete: Cascade)

  @@index([socioId, leida])
  @@map("notificaciones")
}

enum RolUsuario {
  SOCIO
  SUPER_ADMIN
  EDITOR_CONTENIDOS
  PROFESOR
}

enum EstadoSocio {
  ACTIVO
  PENDIENTE
  INACTIVO
}

enum TipoMiembro {
  PRODUCTOR
  ADHERENTE
  HONORARIO
}

enum EstadoCuota {
  PENDIENTE
  PAGADO
  VENCIDO
}

enum EstadoValidacionPago {
  PENDIENTE_REVISION
  APROBADO
  RECHAZADO
}

enum MetodoPago {
  TRANSFERENCIA
  EFECTIVO
  MERCADOPAGO
}

enum ModalidadTaller {
  PRESENCIAL
  VIRTUAL
}

enum EstadoInscripcion {
  PENDIENTE
  CONFIRMADO
  CANCELADO
}

enum EstadoContenido {
  BORRADOR
  PUBLICADO
  PROGRAMADO
}

enum RedSocial {
  TIKTOK
  YOUTUBE
  INSTAGRAM
  LINKEDIN
}

enum EstadoPublicacionRed {
  PENDIENTE
  PUBLICADO
  ERROR
}

enum TipoContenidoTaller {
  DOCUMENTO
  VIDEO
  ENLACE
}
